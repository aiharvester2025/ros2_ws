<?xml version="1.0"?>
<sdf version="1.6">
  <world name="harvester_tree">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <!-- The tree is a static world object, not a ROS-controlled robot. -->
    <include>
      <uri>model://oil_palm_tree</uri>
      <name>oil_palm_tree</name>
      <pose>8.5 0 0 0 0 0</pose>
    </include>
    <!-- Load the harvester at world creation, avoiding the Foxy spawn service
         which was hanging while importing the large URDF. -->
    <include>
      <uri>model://oil_palm_harvester</uri>
      <name>oil_palm_harvester</name>
      <pose>0 0 0.05 0 0 0</pose>
    </include>
  </world>
</sdf>

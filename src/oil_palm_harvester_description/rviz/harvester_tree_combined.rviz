Panels:
  - Class: rviz_common/Displays
  - Class: oil_palm_harvester_description/RangeSensorPanel
    Name: Docking Sensor Values
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 1
      Class: rviz_default_plugins/Grid
      Name: Grid
      Plane: XY
      Cell Size: 1
      Enabled: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Name: Harvester Robot
      Description Topic:
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
      TF Prefix: ""
      Enabled: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Name: Oil Palm Tree
      Description Topic:
        Value: /tree_description
      Visual Enabled: true
      Collision Enabled: false
      TF Prefix: ""
      Enabled: true
    - Class: rviz_default_plugins/Image
      Name: Active Camera View
      Topic:
        Value: /harvester/camera_view/image_raw
      Enabled: true
    - Class: rviz_default_plugins/Image
      Name: Camera + LiDAR Overlay (optional)
      Topic:
        Value: /harvester/perception/camera_lidar/overlay_image
      # The projection node is deliberately disabled by default in the launch
      # to conserve Xavier resources. Enable this display after launching with
      # camera_lidar_projection:=true; it uses this same RViz process.
      Enabled: false
    - Class: rviz_default_plugins/PointCloud2
      Name: Cutting-Arm LiDAR Point Cloud
      Topic:
        Value: /harvester/lidar/points
      Queue Size: 30
      Style: Points
      Size (m): 0.02
      Enabled: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Camera-Frame LiDAR Points (optional)
      Topic:
        Value: /harvester/perception/camera_lidar/visible_points
      Queue Size: 10
      Style: Points
      Size (m): 0.012
      Enabled: false
    - Class: rviz_default_plugins/MarkerArray
      Name: Calibrated Docking Range Rays
      Topic:
        Value: /harvester/docking/range_markers
      Enabled: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Cutter Range Ray
      Topic:
        Value: /harvester/cutter/range_markers
      Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
  Enabled: true
  Global Options:
    Fixed Frame: world
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.785398
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.785398
    Saved: ~
